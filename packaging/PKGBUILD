# Maintainer: musqz
pkgname=fittsmon-wl-gui
pkgver=0.1.0
pkgrel=1
pkgdesc='GTK3 GUI to configure fittsmon-wl screen-corner hotspots on Wayland'
arch=('any')
url="https://github.com/musqz/fittsmon-wl-gui"
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'gtk3' 'gtk-layer-shell' 'wlr-randr' 'xdg-utils' 'fittsmon>=1.3.0')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    sed -i "s/__VERSION__/${pkgver}/" fittsmon-wl-gui.py
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    make install DESTDIR="${pkgdir}" PREFIX=/usr
}
