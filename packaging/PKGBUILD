# Maintainer: musqz
# Local build from the working tree: cd packaging && makepkg -fi
pkgname=fittsmon-wl-gui
pkgver=$(<"$startdir/../VERSION")
pkgrel=1
pkgdesc='GTK3 GUI to configure fittsmon-wl screen-corner hotspots on Wayland'
arch=('any')
url='https://github.com/musqz/fittsmon-wl-gui'
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'gtk3' 'gtk-layer-shell' 'wlr-randr' 'xdg-utils')
optdepends=('fittsmon-wl: the daemon this GUI configures')

package() {
    cd "$startdir/.."
    make install DESTDIR="$pkgdir" PREFIX=/usr
    sed -i "s/__VERSION__/$pkgver/" "$pkgdir/usr/bin/fittsmon-wl-gui"
}
